{
  "name": "@netti/design-system",
  "version": "0.4.1",
  "description": "Netti design system — tokens and React components for multi-product use",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:tokens && vite build && cp src/tokens.css dist/tokens.css",
    "build:tokens": "node sd.config.js",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:storybook": "storybook build",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "chromatic": "^16.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.12",
    "style-dictionary": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
